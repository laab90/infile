<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_fel" model="ir.module.category">
            <field name="name">Factura Electrónica FEL</field>
            <field name="description">Permisos para certificación y anulación de DTE.</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_fel_manager" model="res.groups">
            <field name="name">Administrar y anular DTE</field>
            <field name="category_id" ref="module_category_fel"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="set_draft_invoice" model="res.groups">
            <field name="name">Restablecer documentos a borrador</field>
            <field name="category_id" ref="module_category_fel"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="account_move_complement_company_rule" model="ir.rule">
            <field name="name">Retenciones FEL por compañía</field>
            <field name="model_id" ref="model_account_move_complement"/>
            <field name="domain_force">[('move_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="account_move_payment_company_rule" model="ir.rule">
            <field name="name">Abonos FEL por compañía</field>
            <field name="model_id" ref="model_account_move_payment"/>
            <field name="domain_force">[('move_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="charge_third_party_account_company_rule" model="ir.rule">
            <field name="name">Cobros por cuenta ajena por compañía</field>
            <field name="model_id" ref="model_charge_third_party_account"/>
            <field name="domain_force">[('move_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="res_company_establishment_company_rule" model="ir.rule">
            <field name="name">Establecimientos FEL por compañía</field>
            <field name="model_id" ref="model_res_company_establishment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
        </record>
    </data>
</odoo>
