<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_company_form" model="ir.ui.view">
            <field name="name">view.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="fe" string="FEL / Infile"
                          groups="account.group_account_manager,l10n_gt_fe.group_fel_manager">
                        <group string="Credenciales Infile">
                            <group>
                                <field name="fe_user" autocomplete="off"/>
                                <field name="fe_key_webservice" password="True" autocomplete="new-password"/>
                                <field name="fe_sign_token" password="True" autocomplete="new-password"/>
                            </group>
                            <group>
                                <field name="fe_vat_affiliation"/>
                                <field name="fe_other_email" widget="email"/>
                                <field name="fe_phrase_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Establecimientos FEL">
                            <field name="fe_establishment_ids"
                                   nolabel="1"
                                   colspan="2"
                                   class="w-100">
                                <tree editable="bottom">
                                    <field name="fe_tradename"/>
                                    <field name="fe_code"/>
                                    <field name="fe_tradename_street"/>
                                    <field name="fe_tradename_city"/>
                                    <field name="fe_tradename_state_id"/>
                                    <field name="export_code" optional="hide"/>
                                    <field name="company_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="res_company_view_fe_cui" model="ir.ui.view">
            <field name="name">res.company.form.fel.lookup.infile</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='fe']" position="inside">
                    <group string="Consulta de receptores Infile">
                        <group>
                            <button name="get_token_cui"
                                    type="object"
                                    string="Renovar token CUI"
                                    icon="fa-refresh"
                                    class="btn-secondary"/>
                        </group>
                        <group>
                            <field name="cosume_date"/>
                            <field name="due_date"/>
                            <field name="token" invisible="1"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
